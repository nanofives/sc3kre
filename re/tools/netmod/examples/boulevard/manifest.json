{
 "netpack": 1,
 "name": "boulevard",
 "version": "0.3.0",
 "author": "netmod (task boulevard, bvlanes)",
 "description": "Boulevards: draw three parallel straight roads side by side (at least three columns) and sc3netmod's BV block makes them one boulevard. The outer roads are the carriageways (stock road look, yellow centre line), the middle road gives each one an extra lane and holds a grass median with avenue 11204's trees, about twice as wide as the stock avenue's. Single straight roads crossing it or meeting it from one side get junctions with crosswalks (the median ends in a nose); where all three roads stop the end column closes it with a round curb; where only one goes on, the boulevard tapers into it over its last three columns; where two neighbouring roads go on, it narrows back into the stock avenue. Lane lines are white dashes. Traffic (task bvlanes): 3 lanes each way, right-hand, one way per side; the narrowing meets the one-way avenue halves of avenue_lanes. Built by `boulevard.py build .` in this folder before install (art/ is made from the game's frames and is not shipped).",
 "game": {
  "Apps/SIMNTWRK.DLL": "693f65724a08f1bbc920c4ede1b6c1d5c78c8b95fce0164da10b03fbfe526f61"
 },
